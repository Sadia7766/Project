MM project (Guessing a letter)

.model small
.stack 100h
.data
    letters db 'A', 'G', 'M', 'D', 'S'
    userGuess db ?
    msg1 db 'Guess a letter (you have 2 chances): $'
    msg2 db 10,13, 'Guess a letter again (last chance): $'
    msgWin db 10,13, 'Congratulations! You guessed the letter!$'
    msgLose db 10,13, 'Sorry, you have no more chances. Valid letters were:
A, G, M, D, S.$'


.code
main:
    mov ax, @data
    mov ds, ax


    mov dx,offset msg1
    mov ah,9
    int 21h


    mov ah,1
    int 21h
    sub al,20h
    mov userGuess,al


    mov cx,5
    lea si,letters
    mov al, userGuess

check_loop1:
    cmp al, [si]
    je valid_guess1
    inc si
    loop check_loop1


    jmp second_chance

valid_guess1:
    mov dx,offset msgWin
    mov ah,9
    int 21h
    jmp exit

second_chance:
    mov dx,offset msg2
    mov ah,9
    int 21h


    mov ah,1
    int 21h
    sub al,20h
    mov userGuess,al


    mov cx,5
    lea si, letters
    mov al, userGuess

check_loop2:
    cmp al, [si]
    je valid_guess2
    inc si
    loop check_loop2


    jmp lose

valid_guess2:
    mov dx,offset msgWin
    mov ah,9
    int 21h
    jmp exit

lose:

    mov dx,offset msgLose
    mov ah,9
    int 21h
    jmp exit

exit:
    mov ax,4ch
    int 21h
end main

